# Database (Postgres, e.g. Railway/Render/Supabase)
DATABASE_URL="postgresql://user:password@localhost:5432/strent"

# Auth
JWT_SECRET="replace-with-a-long-random-string"

# Google Maps (JS API + Places autocomplete)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="your-google-maps-key"

# Cloudinary (listing photo storage)
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# M-Pesa Daraja API (payments)
MPESA_CONSUMER_KEY=""
MPESA_CONSUMER_SECRET=""
MPESA_SHORTCODE=""
MPESA_PASSKEY=""
MPESA_CALLBACK_URL="https://your-domain.com/api/payments/mpesa/callback"
