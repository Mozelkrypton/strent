// Strent database schema
// Postgres. Run `npx prisma migrate dev` after setting DATABASE_URL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  TENANT
  LANDLORD
  ADMIN
}

// Separate from Role on purpose: Role is "what kind of user is this",
// AdminLevel is "how much staff power does this admin have". Only set
// when role = ADMIN. SUPER_ADMIN can manage other admins; ADMIN can't.
// A third, narrower VERIFIER tier (verification queue only, nothing else)
// can slot in here later without a schema rewrite.
enum AdminLevel {
  SUPER_ADMIN
  ADMIN
}

enum ListingStatus {
  AVAILABLE
  BOOKED
  UNAVAILABLE
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  phone        String?
  passwordHash String
  role         Role     @default(TENANT)
  verified     Boolean  @default(false) // landlord ID/ownership check passed
  suspended    Boolean  @default(false) // admin-disabled account; blocks login
  adminLevel   AdminLevel? // only set when role = ADMIN
  region       String? // reserved for future region-scoped admins; unused for now
  avatarUrl    String?
  bio          String?
  createdAt    DateTime @default(now())

  // --- account security ---
  emailVerified        Boolean   @default(false)
  failedLoginAttempts  Int       @default(0)
  lockedUntil          DateTime? // set when too many failed attempts; login blocked until this passes
  twoFactorEnabled     Boolean   @default(false)
  twoFactorSecret      String? // TOTP secret, only set once 2FA is enabled
  twoFactorBackupCodes String[] @default([]) // hashed one-time backup codes

  listings              Listing[]              @relation("LandlordListings")
  buildings             Building[]             @relation("LandlordBuildings")
  conversations         Conversation[]         @relation("TenantConversations")
  messages              Message[]
  bookings              Booking[]              @relation("TenantBookings")
  reviews               Review[]
  savedListings         SavedListing[]         @relation("TenantSavedListings")
  verificationRequests  VerificationRequest[]  @relation("LandlordVerificationRequests")
  reviewedVerifications VerificationRequest[]  @relation("AdminReviewedVerifications")
  adminActions          AdminActionLog[]
  sessions              Session[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens   PasswordResetToken[]
  loginEvents           LoginEvent[]
}

// One row per signed-in device/browser. Cookie holds the plain token;
// only its hash is stored, so a leaked DB dump can't be replayed.
model Session {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  userAgent  String?
  ipAddress  String?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?

  @@index([userId])
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// Audit trail: every login attempt, success or failure.
model LoginEvent {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  email     String // the email that was attempted, even if it didn't match a user
  success   Boolean
  reason    String? // e.g. "invalid_password", "locked_out", "bad_2fa_code"
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([email])
}

enum UnitType {
  BEDSITTER
  ONE_BEDROOM
  TWO_BEDROOM
  THREE_BEDROOM
  FOUR_BEDROOM
  FIVE_BEDROOM
  SIX_BEDROOM
}

// A physical property a landlord owns — one address, one map pin, shared by
// every unit inside it. A landlord with just one standalone house never
// needs one of these; Listing.buildingId stays null for them.
model Building {
  id          String   @id @default(cuid())
  name        String
  address     String
  latitude    Float? // null when the landlord skipped the map picker
  longitude   Float?
  description String?
  createdAt   DateTime @default(now())

  landlordId String
  landlord   User   @relation("LandlordBuildings", fields: [landlordId], references: [id], onDelete: Cascade)

  listings Listing[]

  @@index([landlordId])
  @@index([latitude, longitude])
}

model Listing {
  id          String        @id @default(cuid())
  title       String
  description String
  price       Int // monthly rent, in KES
  bedrooms    Int // kept for existing filters/sort; derived from unitType when set
  unitType    UnitType? // real unit-size type for new listings (bedsitter, 1BR..6BR)
  bathrooms   Int
  address     String // building's address is copied here on create, kept for standalone listings
  latitude    Float? // null when the landlord skipped the map picker
  longitude   Float?
  status      ListingStatus @default(AVAILABLE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  landlordId String
  landlord   User   @relation("LandlordListings", fields: [landlordId], references: [id], onDelete: Cascade)

  // A unit belonging to one of the landlord's Buildings — optional, so a
  // landlord with a single standalone house never has to create a Building.
  buildingId String?
  building   Building? @relation(fields: [buildingId], references: [id], onDelete: Cascade)

  images        ListingImage[]
  conversations Conversation[]
  bookings      Booking[]
  reviews       Review[]
  savedBy       SavedListing[]

  // Cached aggregates, recomputed by ReviewService whenever a review is
  // written — lets the browse grid sort/filter by any category cheaply,
  // without joining and averaging Review rows on every page load.
  avgRating          Float? // overall average across all categories
  avgRatingLocation  Float?
  avgRatingValue     Float?
  avgRatingCondition Float?
  avgRatingUtilities Float?
  avgRatingLandlord  Float?
  reviewCount        Int    @default(0)

  @@index([latitude, longitude])
  @@index([status])
}

model ListingImage {
  id        String  @id @default(cuid())
  url       String
  listingId String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
}

// One thread per (listing, tenant) pair
model Conversation {
  id        String   @id @default(cuid())
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  tenantId  String
  tenant    User     @relation("TenantConversations", fields: [tenantId], references: [id], onDelete: Cascade)
  messages  Message[]
  createdAt DateTime @default(now())

  @@unique([listingId, tenantId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  content        String
  readAt         DateTime?
  createdAt      DateTime     @default(now())

  // "Delete for me" only — a userId in here means this message is hidden
  // from that user's view. The other participant (and an admin resolving a
  // dispute) still sees it in full; nothing is ever truly erased. This is
  // what keeps messaging a reliable record of what was agreed.
  deletedFor String[] @default([])

  @@index([conversationId, createdAt])
}

// Created once tenant + landlord agree in chat; tracks the payment/handshake
model Booking {
  id            String        @id @default(cuid())
  listingId     String
  listing       Listing       @relation(fields: [listingId], references: [id], onDelete: Cascade)
  tenantId      String
  tenant        User          @relation("TenantBookings", fields: [tenantId], references: [id], onDelete: Cascade)
  status        BookingStatus @default(PENDING)
  amount        Int // agreed amount, KES
  mpesaReceipt  String? // set once payment confirmed via Daraja callback
  moveInDate    DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

// One review per tenant per listing. Rated across categories rather than a
// single star, so browse/sort can be tailored to what each tenant actually
// cares about (e.g. someone prioritizing water reliability over decor).
model Review {
  id        String   @id @default(cuid())
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  tenantId  String
  tenant    User     @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  ratingLocation  Int // security & accessibility of the area, 1-5
  ratingValue     Int // fairness of price for what you get, 1-5
  ratingCondition Int // state of the house itself, 1-5
  ratingUtilities Int // water/power reliability, 1-5
  ratingLandlord  Int // landlord responsiveness & fairness, 1-5

  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([listingId, tenantId])
  @@index([listingId])
}

// A tenant's shortlist — the rental equivalent of a "cart": houses they're
// considering, not something they buy multiples of.
model SavedListing {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    User     @relation("TenantSavedListings", fields: [tenantId], references: [id], onDelete: Cascade)
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([tenantId, listingId])
  @@index([tenantId])
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

// A landlord's submission to earn the Verified badge — ID + proof of
// ownership/authority to let out property, reviewed by an admin.
model VerificationRequest {
  id     String @id @default(cuid())
  userId String
  user   User   @relation("LandlordVerificationRequests", fields: [userId], references: [id], onDelete: Cascade)

  idDocumentUrl        String
  ownershipDocumentUrl String
  note                 String? // anything the landlord wants the reviewer to know

  status          VerificationStatus @default(PENDING)
  rejectionReason String?
  reviewedById    String?
  reviewedBy      User?              @relation("AdminReviewedVerifications", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt      DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([status])
}

// Every privileged action an admin takes — who, what, on whom, when. This is
// the accountability layer that makes granting the admin role safe.
model AdminActionLog {
  id      String @id @default(cuid())
  adminId String
  admin   User   @relation(fields: [adminId], references: [id], onDelete: Cascade)

  action     String // e.g. "user.suspend", "listing.remove", "verification.approve"
  targetType String // e.g. "User", "Listing", "VerificationRequest"
  targetId   String
  detail     String?

  createdAt DateTime @default(now())

  @@index([adminId])
  @@index([targetType, targetId])
}
